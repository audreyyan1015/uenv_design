{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uenv://schemas/vnext/PlainAgentConfig",
  "type": "object",
  "description": "轻量智能体配置",
  "additionalProperties": false,
  "properties": {
    "history_policy": {
      "type": "string",
      "description": "full 保留完整历史；last_generation 保留系统提示、初始任务和最近一次完整模型及工具或环境交互",
      "enum": [
        "full",
        "last_generation"
      ],
      "default": "full"
    },
    "system_prompt": {
      "type": "string",
      "description": "智能体系统提示词；空表示不额外添加",
      "default": ""
    }
  },
  "required": [
    "history_policy",
    "system_prompt"
  ]
}
